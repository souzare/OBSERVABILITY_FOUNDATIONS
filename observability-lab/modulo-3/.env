# ---------- Aplicação ----------
PORT=3000
SERVICE_NAME=checkout-api
SERVICE_VERSION=1.0.0

# Chance de cada tentativa de gravar no "banco" falhar (0.3 = 30%). São até 3 tentativas.
DB_ERROR_RATE=0.3

# Fração dos traces enviada ao Jaeger (1.0 = 100%, sem sampling; 0.1 = 10%)
TRACE_SAMPLE_RATE=1.0

# Para onde a app envia os traces (Jaeger, protocolo OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---------- Grafana ----------
# A porta 3000 já é da app, então o Grafana fica na 3001
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
