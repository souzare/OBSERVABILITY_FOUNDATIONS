# ---------- Os dois serviços ----------
SERVICE_VERSION=1.0.0

# Fração dos traces enviada ao Jaeger (1.0 = 100%, sem sampling; 0.1 = 10%)
TRACE_SAMPLE_RATE=1.0

# Para onde os serviços enviam os traces (Jaeger, protocolo OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---------- checkout-api ----------
# Endereço do serviço de pagamentos dentro da rede do Docker Compose
PAYMENT_SERVICE_URL=http://payment-service:3001

# Chance de cada tentativa de gravar no "banco" falhar (0 = desligado neste módulo)
DB_ERROR_RATE=0

# ---------- payment-service ----------
# Chance de o pagamento dar timeout (0.05 = 5%)
PAYMENT_ERROR_RATE=0.05

# ---------- Grafana ----------
# A porta 3000 é da checkout-api, então o Grafana fica na 3001 (na máquina/instância)
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
