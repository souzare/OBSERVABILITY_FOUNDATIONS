# ---------- Os dois serviços ----------
SERVICE_VERSION=1.0.0

# Fração dos traces enviada (1.0 = 100%)
TRACE_SAMPLE_RATE=1.0

# O destino dos traces mudou: em vez do Jaeger, o Datadog Agent.
# É a ÚNICA mudança necessária para os traces irem para o Datadog.
OTEL_EXPORTER_OTLP_ENDPOINT=http://datadog-agent:4318

# Ambiente: aparece como "env" no Datadog e separa esta demo de outros dados da conta
DD_ENV=obsf-lab
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=obsf-lab,deployment.environment=obsf-lab

# ---------- checkout-api ----------
PAYMENT_SERVICE_URL=http://payment-service:3001
DB_ERROR_RATE=0

# ---------- payment-service ----------
PAYMENT_ERROR_RATE=0.05
PAYMENT_ERROR_DELAY_MS=300
