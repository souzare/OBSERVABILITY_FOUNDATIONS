# Copie este arquivo para "segredos.env" e preencha.
# O segredos.env está no .gitignore: ele NÃO deve ir para o GitHub (o repositório é público).

# ---------- Datadog ----------
# Organization Settings > API Keys
DD_API_KEY=
# O "site" da sua conta: datadoghq.com, us3.datadoghq.com, us5.datadoghq.com, datadoghq.eu ...
# (é o que aparece no endereço do navegador quando você está logado)
DD_SITE=datadoghq.com

# ---------- Gremlin (só para a parte de testes de resiliência) ----------
# Gremlin > Team Settings > Configuration
GREMLIN_TEAM_ID=
GREMLIN_TEAM_SECRET=
