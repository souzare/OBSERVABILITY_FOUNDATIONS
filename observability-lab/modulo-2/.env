# ---------- Aplicação ----------
PORT=3000
SERVICE_NAME=checkout-api
SERVICE_VERSION=1.0.0

# Chance de falha no GET /orders/:id (0.05 = 5%)
ERROR_RATE=0.05

# Para onde a app envia os traces (Jaeger, protocolo OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---------- Grafana ----------
# A porta 3000 já é da app, então o Grafana fica na 3001
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
